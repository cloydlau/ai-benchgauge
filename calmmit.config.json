{
  "version": 1,
  "deployment": {
    "credentials": {
      "provider": "wechat-upload",
      "projectConfigs": [
        "apps/weapp/project.config.json"
      ],
      "privateKeyPath": "apps/weapp/private.{appid}.key"
    }
  },
  "library": "../calmmit",
  "preset": "swift",
  "steps": {
    "lint": true,
    "tests": true,
    "format": false,
    "unused": false,
    "build": true,
    "dependencies": false,
    "audit": false,
    "secrets": true,
    "media": false,
    "alint": false,
    "worktrees": true,
    "iosDeploy": true,
    "x18n": true
  },
  "commands": {
    "lint": [
      [
        "node",
        "Scripts/ios-deploy.mjs",
        "checkpoint"
      ],
      [
        "node",
        "Scripts/check-syntax.mjs"
      ]
    ],
    "tests": [
      "node",
      "Scripts/test.mjs",
      "--coverage"
    ],
    "build": [
      "node",
      "Scripts/ci-build.mjs"
    ],
    "iosDeploy": [
      "node",
      "Scripts/ios-deploy.mjs",
      "enqueue"
    ],
    "x18n": [
      "node",
      "Scripts/calmmit.mjs",
      "x18n",
      "--advisory"
    ]
  },
  "profiles": {
    "commit": [
      "lint",
      "tests",
      "alint",
      "iosDeploy",
      "x18n"
    ],
    "check": [
      "lint",
      "tests",
      "build",
      "alint",
      "iosDeploy",
      "x18n"
    ],
    "push": [
      "lint",
      "tests",
      "iosDeploy",
      "x18n"
    ]
  },
  "identity": {
    "allowConfiguredModel": false,
    "human": {
      "name": "Cloyd Lau",
      "email": "31238760+cloydlau@users.noreply.github.com"
    },
    "avatarDirectory": "assets/logos",
    "avatarFiles": {
      "glm": "zai.png",
      "deepseek": "deepseek.png",
      "openai": "openai.png",
      "claude": "anthropic.png",
      "kimi": "kimi.png",
      "grok": "spacexai.png",
      "qwen": "qwen.png",
      "gemini": "google.png",
      "meta": "meta.png",
      "mimo": "xiaomi.png",
      "devin": "devin.png"
    },
    "avatarAliases": {
      "devin": "devin"
    }
  },
  "commit": {
    "review": true,
    "generateMessage": true,
    "push": false,
    "split": true,
    "autoUpgrade": false,
    "backgroundReview": false,
    "backgroundCoverage": false
  },
  "repair": {
    "enabled": true
  },
  "dev": {
    "activity": [
      {
        "kind": "backend",
        "receipt": "work/shared-fc-auto/success.json",
        "sources": ["fc"]
      },
      {
        "kind": "mini-program",
        "label": "小程序",
        "receipt": "apps/weapp/.last-publish",
        "sources": [
          "apps/weapp/src",
          "apps/weapp/test",
          "apps/weapp/assets",
          "apps/weapp/scripts",
          "apps/weapp/vite.config.js",
          "apps/weapp/postcss.config.js",
          "apps/weapp/tsconfig.json",
          "apps/weapp/package.json",
          "apps/weapp/project.config.json",
          "apps/weapp/ci-runtime/package.json",
          "apps/weapp/ci-runtime/package-lock.json",
          "fc/domain.mjs",
          "fc/distributions.mjs",
          "fc/price-catalog.mjs",
          "fc/arena-dataset.mjs",
          "fc/brand-catalog.json",
          "fc/leaderboard-policy.json",
          "fc/country-catalog.json",
          "fc/purchase-links.json",
          "Scripts/generate-purchase-links.mjs",
          "Scripts/source-logos.mjs",
          "Sources/LeaderboardKit/PurchaseLinkData.generated.swift",
          "assets/brand/header-logo.png",
          "assets/brand/header-logo-dark.png",
          "assets/brand/partners",
          "assets/logos",
          "assets/about",
          "apps/ios/UI/Resources/CategoryIcons",
          "Sources/LeaderboardKit/SharedLeaderboardConfiguration.swift",
          "config/app.json",
          "Sources/LeaderboardKit/Resources/Fonts/SlideFont-OFL.txt",
          "Sources/LeaderboardKit/Resources/EpochAttribution.json",
          "Sources/LeaderboardKit/Resources/CC-BY-4.0.json",
          "Sources/LeaderboardKit/Resources/ModelDetailLabels.json",
          "Sources/LeaderboardKit/Resources/SourceTabThemes.json",
          "fc/models-dev-license.txt",
          "Tests/fixtures/model-details.json",
          "Tests/fixtures/calendar-timestamps.json",
          "fc/arena-attribution.json",
          "LICENSE",
          "package.json",
          "pnpm-lock.yaml",
          "pnpm-workspace.yaml",
          "Scripts/weapp-deploy.mjs",
          "Scripts/app-version.mjs",
          "Scripts/calmmit.mjs",
          "Scripts/contributor-circles.mjs",
          "calmmit.config.json",
          "Scripts/sync-privacy-guide.mjs",
          "privacy-guide.json"
        ]
      },
      {
        "kind": "mac-app",
        "executable": "outputs/AI-BenchGauge.app/Contents/MacOS/leaderboard-menu",
        "sources": [
          "Sources",
          "apps/macos",
          "assets",
          "config",
          "Package.swift",
          "Package.resolved",
          "make-app.sh",
          "Scripts/make-app.sh",
          "Scripts/package-macos.sh",
          "Scripts/build-cache.mjs"
        ],
        "revisionReceipt": "work/.last-app-deploy",
        "label": "macOS"
      },
      {
        "kind": "ios-app",
        "label": "iOS",
        "receipt": "work/ios-deploy/installed.json",
        "statusReceipt": "work/ios-deploy/status.json",
        "configReceipt": ".benchgauge-ios.local.json",
        "sources": [
          "Sources/LeaderboardKit",
          "apps/ios/App",
          "apps/ios/UI",
          "assets",
          "config",
          "Package.swift",
          "Package.resolved",
          "Scripts/ios-project.mjs",
          "Scripts/ios-icon.swift"
        ]
      }
    ],
    "enabled": true,
    "command": [
      "node",
      "Scripts/watch.mjs"
    ],
    "themeColor": "#0070e3",
    "update": true
  }
}
