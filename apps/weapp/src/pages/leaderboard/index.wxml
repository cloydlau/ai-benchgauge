<page-meta page-style="{{backgroundLocked ? 'overflow:hidden;' : ''}}" />
<view class="shell leaderboard {{category === 'usage' ? 'usage-category' : ''}} {{dark ? 'dark' : ''}} {{grouping === 'company' ? 'company-view' : ''}}" style="--country-column:{{labels.country === 'Country' ? 84 : 58}}rpx;--source-column:{{labels.source.length === 2 ? 58 : 76}}rpx;--distribution-name-width:{{labels.country === 'Country' ? 144 : 96}}px;">
  <view class="brand-head {{labels.name === 'AI BenchGauge' ? 'brand-en' : ''}}" style="min-height:{{navHeight}}px;padding-top:{{headerTop}}px;padding-right:{{capsuleWidth}}px;">
    <view class="brand-copy">
      <view class="brand-title brand-wordmark" style="{{brandTitle.style}}" aria-label="{{labels.name}}">
        <image wx:if="{{brandTitle.logoWidth > 0 && brandTitle.logoHeight > 0}}" class="brand-letter-logo" src="{{dark ? '/assets/header-logo-dark.png' : '/assets/header-logo.png'}}" mode="scaleToFill" style="{{brandTitle.logoStyle}}" aria-hidden="true" />
        <image wx:for="{{brandTitle.glyphs}}" wx:key="key" class="brand-glyph" src="{{item.source}}{{dark ? '-dark' : ''}}.svg" mode="scaleToFill" style="{{item.style}}" aria-hidden="true" />
      </view>
      <button wx:if="{{brandTitle.showSubtitle}}" class="subtitle" style="width:{{brandTitle.subtitleWidth}}px;height:{{brandTitle.subtitleHeight}}px;font-size:{{brandTitle.subtitleFontSize}}px;" bindtap="quotaHelp" aria-label="{{labels.subtitle}}">
        <view class="subtitle-line"><text>{{subtitleParts[0]}}</text></view>
        <view class="subtitle-line"><text>{{subtitleParts[1]}}</text><view class="subtitle-help" style="margin-left:{{brandTitle.subtitleHelpOffset}}em;" aria-hidden="true"><van-icon name="question-o" size="{{brandTitle.subtitleFontSize}}px" custom-style="display:block;line-height:1;opacity:0.55;" /></view></view>
      </button>
    </view>
    <view class="pill grouping" style="height:{{groupingControl.height}}px;width:{{groupingControl.width}}px;font-size:{{groupingControl.fontSize}}px;">
      <button class="pill-option {{grouping === 'model' ? 'selected' : ''}}" data-id="model" bindtap="selectGrouping">{{labels.models}}</button>
      <button class="pill-option {{grouping === 'company' ? 'selected' : ''}}" data-id="company" bindtap="selectGrouping">{{labels.companies}}</button>
    </view>
  </view>
  <view class="board-stage">
  <view class="source-tabs " role="tablist" style="{{sourceTabsStyle}}" data-tabs="source" bindtouchstart="tabStart" catchtouchmove="tabMove" bindtouchend="tabEnd" bindtouchcancel="cancelTabDrag">
    <view class="source-selection" style="{{sourceSelection}}" aria-hidden="true" />
    <button wx:for="{{tabs}}" wx:key="*this" class="source-tab source-{{index}} {{sourceTabIndex === index ? 'active' : ''}}"
      data-index="{{index}}" bindtap="selectFace" role="tab" aria-selected="{{sourceTabIndex === index}}">{{item}}</button>
  </view>
  <view class="boards" style="{{entranceStyle}}{{cubeViewportStyle}}" bindtouchstart="cubeStart" bindtouchmove="cubeMove" bindtouchend="cubeEnd" bindtouchcancel="cubeCancel">
    <view wx:if="{{entranceHintVisible && tabs.length > 1}}" class="cube-launch-hint"><text>↕ {{labels.cubeScroll}}</text><view class="cube-hint-divider" /><text>↔ {{labels.cubeSwitch}}</text></view>
    <view wx:for="{{cards}}" wx:for-item="card" wx:key="kind" class="board-face" style="{{cubeFaces[card.index].style}}" aria-hidden="{{face !== card.index}}">
      <!-- The native indicator rests inside the clipped source-tab spacer.
           Keep its loading feedback in the visible part of this cube face. -->
      <view wx:if="{{pullRefreshKind === card.kind}}" class="pull-refresh-status {{pullRefreshing ? 'refreshing' : 'restoring'}}" role="status" aria-label="{{labels.loading}}">
        <view class="pull-refresh-dot" /><view class="pull-refresh-dot" /><view class="pull-refresh-dot" />
      </view>
      <scroll-view id="board-scroll-{{card.kind}}" class="board-scroll" scroll-y="{{!backgroundLocked && (!cubeDragging || face !== card.index)}}" enhanced show-scrollbar="{{false}}"
        refresher-enabled="{{!backgroundLocked && (!cubeDragging || face !== card.index)}}" refresher-triggered="{{pullRefreshing && pullRefreshKind === card.kind}}" refresher-default-style="{{dark ? 'white' : 'black'}}" refresher-background="{{dark ? '#101216' : '#f4f5f7'}}"
        data-kind="{{card.kind}}" scroll-anchoring="{{false}}"
        bindscroll="scroll" bindrefresherrefresh="pullRefresh" bindrefresherrestore="finishPullRefresh" bindrefresherabort="finishPullRefresh">
        <view class="source-tabs-spacer" style="height:{{sourceTabsExtent}}px;" aria-hidden="true" />
        <view class="board-card source-{{card.index}}" style="{{card.themeStyle}}">
          <view class="metadata">
            <button class="summary" data-kind="{{card.kind}}" bindtap="sourceHelp">{{card.summary}}</button>
          </view>
          <view id="head-anchor-{{card.kind}}" class="table-head-anchor" aria-hidden="true" />
          <view id="table-head-{{card.kind}}" class="table-head {{card.headerPinned ? 'table-head-pinned' : ''}} {{modelSearchVisible ? 'model-search-open' : ''}}">
          <view class="table-head-content table-grid" aria-hidden="{{modelSearchVisible}}">
            <text class="rank-cell">{{labels.rank}}</text>
            <view class="model-heading">
            <view class="source-heading-details">
            <button class="source-heading" data-kind="{{card.kind}}" bindtap="copyBoardTitle" aria-label="{{labels.copyName}} {{card.title}}">{{card.title}}</button>
            <view class="source-heading-actions">
            <view class="times" aria-label="{{card.timeAccessibility}}" aria-busy="{{card.loading}}">
              <view class="time-copy">
                <view class="time-row {{card.isSourceTime ? 'time-source' : 'time-fetched'}}"><text class="time-value">{{card.time}}</text><view class="time-caption {{card.loading ? 'time-caption-loading' : ''}}"><text class="time-label">{{card.timeLabel}}</text><view wx:if="{{card.loading}}" class="time-loading" aria-hidden="true" /></view></view>
                <view wx:if="{{card.polishing}}" class="time-row time-polish {{card.isSourceTime ? 'time-source' : 'time-fetched'}}" aria-hidden="true"><text class="time-value">{{card.time}}</text><view class="time-caption"><text class="time-label">{{card.timeLabel}}</text></view></view>
              </view>
            </view>
            <button wx:if="{{grouping === 'model'}}" id="model-filter-{{card.kind}}" class="model-filter-toggle" data-kind="{{card.kind}}" bindtap="openModelSearch" aria-label="{{labels.searchModels}}"><van-icon name="search" size="13px" /></button>
            </view>
            </view>
            </view>
            <button class="filter {{card.countryFiltered ? 'filtered' : ''}}" data-kind="{{card.kind}}" data-mode="country" bindtap="filterMenu">
              <view class="filter-label">{{labels.country}}<view class="filter-arrow" aria-hidden="true"><van-icon name="{{card.countryFiltered ? 'filter-o' : 'arrow-down'}}" size="{{card.countryFiltered ? '8px' : '7px'}}" /></view></view>
            </button>
            <button wx:if="{{grouping !== 'company'}}" class="filter {{card.sourceFiltered ? 'filtered' : ''}}" data-kind="{{card.kind}}" data-mode="openness" bindtap="filterMenu">
              <view class="filter-label">{{labels.source}}<view class="filter-arrow" aria-hidden="true"><van-icon name="{{card.sourceFiltered ? 'filter-o' : 'arrow-down'}}" size="{{card.sourceFiltered ? '8px' : '7px'}}" /></view></view>
            </button>
            <text class="score-cell">{{card.scoreLabel}}</text>
          </view>
          <view class="model-search" style="{{card.searchStyle}}" aria-hidden="{{!modelSearchVisible}}">
            <view class="model-search-content">
              <van-icon name="search" size="14px" />
              <input wx:if="{{modelSearchVisible}}" class="model-search-input" value="{{modelSearchQuery}}" placeholder="{{labels.searchModels}}" placeholder-class="model-search-placeholder"
                focus="{{modelSearchFocused && card.index === face}}" disabled="{{card.index !== face}}" confirm-type="done" bindinput="inputModelSearch" bindfocus="focusModelSearch" bindblur="deferModelSearchBlur" bindconfirm="deferModelSearchBlur" aria-label="{{labels.searchModels}}" />
              <button wx:if="{{modelSearchQuery}}" class="model-search-clear" bindtouchstart="beginModelSearchClear" bindtouchcancel="cancelModelSearchClear" bindtap="clearModelSearch" aria-label="{{labels.clearSearch}}"><van-icon name="clear" size="13px" /></button>
              <button class="model-search-cancel" bindtap="closeModelSearch">{{labels.cancel}}</button>
            </view>
          </view>
          </view>
          <view wx:if="{{card.loading && !card.hasBoard}}" class="ranking-skeleton" aria-label="{{labels.loading}}" aria-role="text">
            <view wx:for="{{skeletonRows}}" wx:key="*this" class="skeleton-row table-grid" style="height:{{card.rowHeight}}px;" aria-hidden="true">
              <view class="skeleton-block skeleton-rank" />
              <view class="skeleton-name"><view class="skeleton-block skeleton-logo" /><view class="skeleton-copy"><view class="skeleton-block skeleton-line" style="width:{{index % 3 === 0 ? 86 : index % 3 === 1 ? 65 : 76}}%;" /><view class="skeleton-block skeleton-line skeleton-line-short" /></view></view>
              <view class="skeleton-block skeleton-country" />
              <view wx:if="{{grouping !== 'company'}}" class="skeleton-block skeleton-source" />
              <view class="skeleton-block skeleton-score" />
            </view>
          </view>
          <view wx:elif="{{!card.count}}" class="empty-state">
            <van-icon name="bar-chart-o" size="30px" /><text>{{card.hasBoard ? labels.empty : card.pendingConfiguration ? labels.dataPending : labels.noBoard}}</text>
            <button wx:if="{{card.filtered}}" class="reset-button" data-kind="{{card.kind}}" bindtap="clearFilters">{{labels.reset}}</button>
          </view>
          <view id="rows-{{card.kind}}" class="virtual-rows" style="height:{{card.height}}px;">
          <view wx:for="{{card.rows}}" wx:for-item="row" wx:key="rank" style="top:{{row.top}}px;height:{{card.rowHeight}}px;" class="table-row table-grid {{row.rank % 2 === 0 ? 'alternate' : ''}}">
            <view class="row-fill-track" aria-hidden="true"><view class="name-fill" style="{{row.fill}}width:{{row.fillPercent}}%;" /></view>
            <text class="rank-cell mono">{{row.medal}}</text>
            <view class="name-cell {{row.purchaseActions.length ? 'with-purchase-links' : ''}}">
            <button class="name-action" data-kind="{{card.kind}}" data-rank="{{row.rank}}" bindtap="rowDetails" aria-label="{{row.name}}">
              <image wx:if="{{row.logo}}" class="model-logo" src="{{row.logo}}" mode="aspectFit" />
              <view wx:else class="model-logo initial">{{row.initial}}</view>
              <text class="model-name">{{row.name}}</text>
            </button>
            <view wx:if="{{row.purchaseActions.length}}" class="purchase-links">
              <button wx:for="{{row.purchaseActions}}" wx:for-item="action" wx:key="kind" class="purchase-link"
                data-kind="{{card.kind}}" data-rank="{{row.rank}}" data-purchase="{{action.kind}}" catchtap="copyPurchaseLink"
                aria-label="{{row.name}} · {{action.title}} · {{labels.copyLink}}">{{action.title}}</button>
            </view>
            </view>
            <button wx:if="{{row.countryUnknown}}" class="country-cell country-help" bindtap="countryHelp" aria-label="{{labels.unknownCountryTitle}}">?</button>
            <button wx:else class="country-cell attribute-action" data-kind="{{card.kind}}" data-rank="{{row.rank}}" data-attribute="country" catchtap="attributeHint" aria-label="{{row.countryName}}">{{row.flag}}</button>
            <button wx:if="{{grouping !== 'company'}}" class="openness-cell attribute-action" hover-class="none" data-kind="{{card.kind}}" data-rank="{{row.rank}}" data-attribute="openness" catchtap="attributeHint" aria-label="{{row.openness === 'open' ? labels.open : row.openness === 'closed' ? labels.closed : labels.unknown}}">
              <image wx:if="{{row.opennessIcon}}" class="openness-icon" src="{{row.opennessIcon}}" mode="aspectFit" aria-hidden="true" />
              <text wx:else>—</text>
            </button>
            <view class="score-cell score-value mono">
              <text>{{row.scoreText}}</text>
              <text wx:if="{{row.scoreShare}}" class="score-share">{{row.scoreShare}}</text>
            </view>
          </view>
          </view>
        </view>
        <button wx:if="{{card.hasMore}}" class="ranking-toggle" data-kind="{{card.kind}}" bindtap="toggleRanking" aria-label="{{card.expansionLabel}}">
          <text>{{card.expansionLabel}}</text><van-icon name="{{card.expanded ? 'arrow-up' : 'arrow-down'}}" size="12px" />
        </button>
        <view class="distribution-charts" aria-label="{{labels.countryShare}} · {{labels.sourceShare}}">
          <view class="distribution-heading"><text>{{labels.countryShare}}</text><text class="distribution-total">{{card.distribution.totalLabel}}</text></view>
          <text wx:if="{{!card.distribution.total}}" class="distribution-note">{{labels.noModels}}</text>
          <view wx:for="{{card.distribution.countries}}" wx:for-item="slice" wx:key="id" class="distribution-country" aria-label="{{slice.name}} {{slice.count}} {{slice.percent}}">
            <view class="distribution-name"><image wx:if="{{slice.flagImage}}" class="distribution-flag" src="{{slice.flagImage}}" mode="aspectFit" aria-hidden="true" /><text wx:else class="distribution-symbol" aria-hidden="true">{{slice.flag}}</text><text class="distribution-label">{{slice.name}}</text></view><view class="distribution-track" aria-hidden="true"><view class="distribution-bar" style="width:{{slice.width}};" /></view><text class="distribution-value mono">{{slice.count}} · {{slice.percent}}</text>
          </view>
          <view class="distribution-heading distribution-source-heading">{{labels.sourceShare}}</view>
          <view class="distribution-source-track" aria-hidden="true"><view wx:for="{{card.distribution.sources}}" wx:for-item="slice" wx:key="id" class="distribution-segment distribution-{{slice.id}}" style="width:{{slice.width}};background:{{slice.color}};" /></view>
          <view wx:for="{{card.distribution.sources}}" wx:for-item="slice" wx:key="id" class="distribution-source-row"><image wx:if="{{slice.icon}}" class="distribution-lock" src="{{slice.icon}}" mode="aspectFit" aria-hidden="true" /><text wx:else class="distribution-symbol" aria-hidden="true">?</text><text>{{slice.name}}</text><text class="distribution-value mono">{{slice.count}} · {{slice.percent}}</text></view>
          <text class="distribution-note">{{labels.distributionBasis}}</text>
        </view>
        <view class="footer safe-bottom {{backToTop ? 'with-back-top' : ''}}">
          <button class="tap" bindtap="about">{{labels.about}}</button>
          <view class="footer-actions">
            <button class="tap" data-mode="language" bindtap="preferences" aria-label="{{labels.language}}"><text class="language-symbol">文/A</text></button>
            <button class="tap" data-mode="theme" bindtap="preferences" aria-label="{{labels.theme}}"><view class="theme-symbol" aria-hidden="true" /></button>
          </view>
        </view>
      </scroll-view>
      <view class="cube-shade" style="opacity:{{cubeFaces[card.index].shade}};transition-duration:{{cubeDuration}}ms;" aria-hidden="true" />
    </view>
  </view>
  </view>
  <view class="category-tabs" style="--category-count:{{categoryItems.length}};{{categoryThemeStyle}}" role="tablist" data-tabs="category" bindtouchstart="tabStart" catchtouchmove="tabMove" bindtouchend="tabEnd" bindtouchcancel="cancelTabDrag">
    <view class="category-glass-selection" style="transform:translateX({{categoryIndex * 100}}%);" aria-hidden="true" />
    <button wx:for="{{categoryItems}}" wx:key="id" class="category-tab {{categoryIndex === index ? 'active' : ''}}"
      data-id="{{item.id}}" bindtap="selectCategory" role="tab" aria-selected="{{category === item.id}}">
      <image class="category-icon" src="{{item.icon}}" mode="aspectFit" aria-hidden="true" /><text class="category-label">{{item.label}}</text>
    </button>
  </view>
  <!-- Let Vant receive option/button touches; backgroundLocked locks the boards. -->
  <van-action-sheet show="{{sheet.open}}" title="{{sheet.title}}" actions="{{sheet.actions}}" bindselect="sheetSelect" bindclose="closeSheet" custom-class="settings-sheet {{dark ? 'dark-sheet' : ''}}" />
  <van-dialog id="company-details" show="{{companyDetails.open}}" use-title-slot use-slot
    show-cancel-button confirm-button-text="{{labels.copyName}}" cancel-button-text="{{labels.cancel}}"
    confirm-button-color="{{dark ? '#d1dce8' : '#414d5c'}}" cancel-button-color="{{dark ? '#f2f5fa' : '#20262f'}}"
    custom-style="background:var(--card);color:var(--ink);--dialog-has-title-message-text-color:var(--muted);--button-default-background-color:var(--card);"
    bindconfirm="copyCompanyName" bindcancel="closeCompanyDetails" bindclose="closeCompanyDetails">
    <view slot="title" class="company-details-title">{{companyDetails.name}}</view>
    <view class="company-details-content">
      <view class="company-details-explanation">{{companyDetails.content}}</view>
      <view wx:for="{{companyDetails.members}}" wx:for-item="member" wx:key="rank" class="company-model-row">
        <text class="company-model-rank">#{{member.rank}}</text>
        <text class="company-model-description">{{member.name}} · {{member.score}}</text>
      </view>
    </view>
  </van-dialog>
  <van-dialog show="{{showingFeatureHelp}}" title="{{labels.featureDetails}}" message="{{quotaHelpContent}}"
    show-cancel-button confirm-button-text="{{labels.gotIt}}" cancel-button-text="{{labels.desktopLink}}"
    confirm-button-color="{{dark ? '#d1dce8' : '#414d5c'}}" cancel-button-color="{{dark ? '#f2f5fa' : '#20262f'}}"
    custom-style="background:var(--card);color:var(--ink);--dialog-has-title-message-text-color:var(--muted);--button-default-background-color:var(--card);"
    bindconfirm="closeFeatureHelp" bindcancel="copyDesktopLink" bindclose="closeFeatureHelp" />
  <canvas id="leaderboard-export" type="2d" class="export-canvas" aria-hidden="true" />
  <!-- capture-panel already includes the bottom safe area; avoid a second strip below it. -->
  <van-popup show="{{capture.open}}" position="bottom" round safe-area-inset-bottom="{{false}}" bindclose="closeCapture" close-on-click-overlay="{{!capture.saving}}" custom-class="capture-popup {{dark ? 'dark-sheet' : ''}}">
    <view class="capture-panel shell {{dark ? 'dark' : ''}}">
      <view class="capture-heading"><text>{{labels.screenshot}}</text><button class="tap" bindtap="closeCapture" disabled="{{capture.saving}}" aria-label="{{labels.close}}"><van-icon name="cross" size="18px" /></button></view>
      <scroll-view scroll-y class="capture-images"><image wx:if="{{capture.path}}" class="capture-image" src="{{capture.path}}" mode="widthFix" bindtap="previewScreenshot" /></scroll-view>
      <view class="capture-actions"><button class="capture-preview" bindtap="previewScreenshot">{{labels.preview}}</button><button class="capture-save" bindtap="saveScreenshot" disabled="{{capture.saving || capture.saved}}">{{capture.saved ? labels.savedImages : labels.saveImages}}</button></view>
    </view>
  </van-popup>
</view>
<!-- Keep the fixed control outside the page's overflow clipping and native scroll layers. -->
<button class="shell back-top {{dark ? 'dark' : ''}} {{backToTop && !cubeBusy && !backgroundLocked ? 'is-visible' : ''}}"
  hidden="{{!backToTop || cubeBusy || backgroundLocked}}" bindtap="top" aria-label="{{labels.back}}">
  <van-icon name="back-top" size="20px" />
</button>
