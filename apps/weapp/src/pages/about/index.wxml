<view class="shell about-page {{dark ? 'dark' : ''}} safe-bottom">
  <view class="about-nav" style="padding-top:{{statusBar}}px;">
    <button class="tap" bindtap="back" aria-label="{{labels.back}}"><van-icon name="arrow-left" size="21px" /></button><text>{{labels.about}}</text>
  </view>
  <view class="about-main">
    <view class="about-hero">
      <view class="about-brand">
        <view class="brand-wordmark" style="{{brandTitle.style}}" aria-label="{{labels.name}}">
          <image wx:if="{{brandTitle.logoWidth > 0 && brandTitle.logoHeight > 0}}" class="brand-letter-logo" src="{{dark ? '/assets/header-logo-dark.png' : '/assets/header-logo.png'}}" mode="scaleToFill" style="{{brandTitle.logoStyle}}" aria-hidden="true" />
          <image wx:for="{{brandTitle.glyphs}}" wx:key="key" class="brand-glyph" src="{{item.source}}{{dark ? '-dark' : ''}}.svg" mode="scaleToFill" style="{{item.style}}" aria-hidden="true" />
        </view>
        <text class="about-version mono">v{{version}}</text>
      </view>
      <view class="about-description">
        <text wx:for="{{descriptionLines}}" wx:key="*this" class="about-description-line">{{item}}</text>
      </view>
      <view class="hero-rule" aria-hidden="true"><view /><view /></view>
    </view>
    <view class="artwork-card">
      <button class="artwork-preview" style="padding-top:{{artwork.height / artwork.width * 100}}%;" bindtap="previewArtwork" hover-class="none" aria-label="{{artwork.alt}} · {{artwork.previewLabel}}">
        <image class="artwork-image" src="{{artwork.image}}" mode="aspectFit" aria-hidden="true" />
      </button>
      <view class="artwork-caption">
        <view class="artwork-heading">
          <view class="artwork-title-stack artwork-title-fit" style="transform:scale({{artworkTitleScale}});"><text class="artwork-title">{{artwork.title}}</text><text class="artwork-subtitle">{{artwork.caption}}</text></view>
          <view class="artwork-title-stack artwork-title-measure" aria-hidden="true"><text class="artwork-title">{{artwork.title}}</text><text class="artwork-subtitle">{{artwork.caption}}</text></view>
        </view>
        <view class="artwork-credits">
          <view wx:for="{{artwork.credits}}" wx:key="id" class="artwork-credit-row">
            <text class="artwork-credit-role">{{item.role}}</text>
            <button class="artwork-credit-person" data-url="{{item.url}}" bindtap="copyLink" aria-label="{{item.role}} · {{item.name}} · {{item.detail}}">
              <image class="artwork-source-icon artwork-source-icon-{{item.sourceIcon}}" src="/assets/source-logos/{{item.sourceIcon}}{{dark ? '-dark' : ''}}.png" mode="aspectFit" aria-hidden="true" />
              <text class="artwork-credit-name">{{item.name}}</text>
            </button>
          </view>
        </view>
      </view>
    </view>
    <view class="about-card platforms-card">
      <text class="section-title platforms-title">{{platforms.title}}</text>
      <view wx:for="{{platforms.items}}" wx:key="id" class="platform-row">
        <view class="platform-icon platform-icon-{{item.id}}" aria-hidden="true">
          <image wx:if="{{item.id === 'weapp'}}" class="platform-wechat" src="/assets/source-logos/wechat{{dark ? '-dark' : ''}}.png" mode="aspectFit" />
          <view wx:else class="platform-device"><view /><view /></view>
        </view>
        <view class="platform-name"><text>{{item.name}}</text><text wx:if="{{item.note}}" class="platform-note">{{item.note}}</text></view>
        <text wx:if="{{item.featureText}}" class="platform-features">{{item.featureText}}</text>
        <text class="platform-status platform-status-{{item.status}}">{{item.statusLabel}}</text>
      </view>
      <button class="platform-contribute" data-url="{{platforms.repositoryURL}}" bindtap="copyLink" aria-label="{{platforms.contributeLabel}} · {{platforms.copyLinkLabel}}">
        <van-icon name="friends-o" size="16px" /><text>{{platforms.contributeLabel}}</text><van-icon name="arrow" size="12px" />
      </button>
    </view>
    <view class="about-card investment-card">
      <text class="section-title">{{investment.title}}</text>
      <view class="investment-details">
        <text class="investment-heading">{{investment.engineeringTitle}}</text>
        <view class="investment-engineering {{contributors.nodes.length ? 'has-contributors' : ''}}">
          <view class="investment-metrics">
            <view wx:for="{{investment.metrics}}" wx:key="id" class="investment-metric">
              <text class="investment-value">{{item.value}}</text>
              <text class="investment-label">{{item.label}}</text>
            </view>
          </view>
          <button wx:if="{{contributors.nodes.length}}" class="contributor-mini" bindtap="openContributors" hover-class="none" aria-label="{{contributors.expandLabel}}">
            <view class="contributor-field" aria-hidden="true">
              <view wx:for="{{contributors.nodes}}" wx:key="id" class="contributor-circle" style="{{item.style}}">
                <image wx:if="{{item.avatar}}" class="contributor-logo {{item.monochrome ? 'contributor-monochrome' : ''}}" src="{{item.avatar}}" mode="aspectFit" />
                <text wx:else class="contributor-initial">{{item.initial}}</text>
              </view>
            </view>
            <view class="contributor-expand" aria-hidden="true"><van-icon name="enlarge" size="13px" /></view>
          </button>
        </view>
        <text class="investment-note">{{investment.note}}</text>
        <text class="investment-heading budget-heading">{{investment.budgetTitle}}</text>
        <text class="investment-note budget-intro">{{investment.budgetIntro}}</text>
        <view wx:for="{{costGroups}}" wx:for-item="group" wx:key="id" class="cost-group {{group.collapsed ? '' : 'is-expanded'}}">
          <button class="cost-group-toggle" data-id="{{group.id}}" bindtap="toggleCostGroup" aria-expanded="{{!group.collapsed}}" aria-label="{{group.toggleLabel}}">
            <text class="cost-group-title">{{group.title}}</text>
            <view class="cost-group-amount"><text class="cost-amount">{{group.amountText}}</text><van-icon name="{{group.collapsed ? 'arrow-down' : 'arrow-up'}}" size="12px" /></view>
          </button>
          <block wx:if="{{!group.collapsed}}">
            <view wx:for="{{group.items}}" wx:key="id" class="investment-item">
              <view class="cost-heading"><text class="investment-item-title">{{item.title}}</text><text class="cost-amount {{item.amount === null ? 'cost-unaccounted' : ''}}">{{item.amountText}}</text></view>
              <text class="investment-note">{{item.body}}</text>
            </view>
          </block>
        </view>
        <view class="cost-heading cost-total"><text>{{investment.totalTitle}}</text><text class="cost-total-value">{{investment.totalText}}</text></view>
        <text class="investment-note cost-note">{{investment.costNote}}</text>
      </view>
    </view>
    <view class="about-card notices">
      <text class="section-title">{{noticesTitle}}</text>
      <text class="muted notice-intro">{{noticesIntro}}</text>
      <view wx:for="{{notices}}" wx:key="id">
        <button class="license-toggle" data-id="{{item.id}}" bindtap="toggleNotice" aria-expanded="{{notice === item.id}}">
          <view class="license-heading"><text>{{item.title}}</text><text class="license-type">{{item.licenseName}}</text></view>
          <van-icon name="{{notice === item.id ? 'arrow-up' : 'arrow-down'}}" size="13px" />
        </button>
        <text wx:if="{{notice === item.id}}" class="license" selectable>{{item.license}}</text>
      </view>
    </view>
  </view>
  <van-popup show="{{contributorsExpanded}}" position="center" round closeable bind:close="closeContributors" custom-style="width:90vw;max-width:560px;background:var(--card);color:var(--ink);">
    <view class="contributors-expanded">
      <text class="section-title">{{contributors.title}}</text>
      <text class="investment-note">{{contributors.note}}</text>
      <view class="contributor-field" aria-label="{{contributors.title}}">
        <button wx:for="{{contributors.nodes}}" wx:key="id" class="contributor-circle {{item.r > 0.09 ? 'contributor-labeled' : ''}} {{selectedContributorID === item.id ? 'is-selected' : ''}}" style="{{item.style}}" data-id="{{item.id}}" bindtap="selectContributor" hover-class="contributor-pressed" aria-label="{{item.name}} · {{item.countLabel}}" aria-pressed="{{selectedContributorID === item.id}}">
          <image wx:if="{{item.avatar}}" class="contributor-logo {{item.monochrome ? 'contributor-monochrome' : ''}}" src="{{item.avatar}}" mode="aspectFit" aria-hidden="true" />
          <text wx:else class="contributor-initial" aria-hidden="true">{{item.initial}}</text>
          <text wx:if="{{item.r > 0.09}}" class="contributor-name" aria-hidden="true">{{item.name}}</text>
        </button>
      </view>
      <view class="contributor-detail" aria-live="polite">
        <block wx:if="{{selectedContributor}}">
          <text class="contributor-selected-name">{{selectedContributor.name}}</text>
          <text class="investment-note">{{selectedContributor.countLabel}}</text>
        </block>
        <text wx:else class="investment-note">{{contributors.hint}}</text>
      </view>
    </view>
  </van-popup>
</view>
