<view class="shell model-page {{dark ? 'dark' : ''}} safe-bottom">
  <view class="model-nav" style="padding-top:{{statusBar}}px;">
    <button class="tap" bindtap="back" aria-label="{{labels.close}}"><van-icon name="arrow-left" size="21px" /></button>
    <text>{{labels.details}}</text>
  </view>
  <view class="model-main">
    <view class="model-heading">
      <text class="model-title" selectable>{{entry.name || labels.details}}</text>
      <button wx:if="{{entry.name}}" id="copy-model-name" class="copy-name tap" bindtap="copyName" aria-label="{{copied ? labels.copied : labels.copy}}">
        <van-icon wx:if="{{copied}}" name="success" size="22px" />
        <view wx:else class="copy-glyph" aria-hidden="true"><view></view><view></view></view>
      </button>
    </view>
    <view wx:if="{{!sections.length}}" class="missing">{{labels.missing}}</view>
    <view wx:for="{{sections}}" wx:for-item="section" wx:key="id" class="detail-section">
      <button wx:if="{{section.summary}}" class="provider-heading" data-id="{{section.id}}" bindtap="toggle" aria-expanded="{{section.expanded}}">
        <view class="provider-title"><text class="section-title">{{section.title}}</text><text class="provider-summary">{{section.summary}}</text></view>
        <van-icon name="{{section.expanded ? 'arrow-up' : 'arrow-down'}}" size="16px" />
      </button>
      <text wx:else class="section-title">{{section.title}}</text>
      <view wx:if="{{section.expanded}}" class="detail-rows">
        <view wx:for="{{section.rows}}" wx:for-item="row" wx:key="index" class="detail-row">
          <text wx:if="{{row.label}}" class="detail-label">{{row.label}}</text>
          <button wx:if="{{row.url}}" class="detail-link" data-url="{{row.url}}" bindtap="copyLink" aria-label="{{row.value}}">
            <text>{{row.value}}</text><van-icon name="link-o" size="14px" />
          </button>
          <text wx:else class="detail-value" selectable>{{row.value}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
