<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <BenchGaugeConfigJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../config/app.json'))</BenchGaugeConfigJson>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(BenchGaugeConfigJson), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</Version>
    <Company>cloydlau</Company>
    <Product>AI BenchGauge</Product>
    <Copyright>Copyright © cloydlau</Copyright>
  </PropertyGroup>
</Project>
