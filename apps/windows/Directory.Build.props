<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <BenchGaugeConfigJson>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../../config/app.json'))</BenchGaugeConfigJson>
    <BenchGaugePublicVersion>$([System.Text.RegularExpressions.Regex]::Match($(BenchGaugeConfigJson), '&quot;version&quot;\s*:\s*&quot;([^&quot;]+)&quot;').Groups[1].Value)</BenchGaugePublicVersion>
    <Version>$([System.Text.RegularExpressions.Regex]::Replace('$(BenchGaugePublicVersion)', '^([0-9]{4})([0-9]{2})([0-9]{2})$', '$1.$2.$3'))</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
    <InformationalVersion>$(BenchGaugePublicVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>cloydlau</Company>
    <Product>AI BenchGauge</Product>
    <Copyright>Copyright © cloydlau</Copyright>
  </PropertyGroup>
</Project>
