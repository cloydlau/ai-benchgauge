<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>AI-BenchGauge</AssemblyName><ApplicationManifest>app.manifest</ApplicationManifest>
    <StartupObject>BenchGauge.Program</StartupObject>
    <ApplicationIcon>../../../assets/brand/AI-BenchGauge.ico</ApplicationIcon>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../../Sources/LeaderboardKit/Resources/Brand/mobile-title.json" LogicalName="BrandWordmark.json" />
    <EmbeddedResource Include="../../../Sources/LeaderboardKit/Resources/EpochAttribution.json" LogicalName="EpochAttribution.json" />
    <EmbeddedResource Include="../../../fc/arena-attribution.json" LogicalName="arena-attribution.json" />
    <Resource Include="../../../Sources/LeaderboardKit/Resources/Fonts/BenchGaugeCalligraphy.ttf" Link="Fonts/BenchGaugeCalligraphy.ttf" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="../BenchGauge.Shared/BenchGauge.Shared.csproj" />
    <Content Include="../../../assets/logos/*.png" Link="logos/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../weapp/assets/flags/*.png" Link="flags/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../weapp/assets/flags/LICENSE" Link="Licenses/flag-icons.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../assets/brand/AI-BenchGauge.ico" Link="brand/AI-BenchGauge.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../assets/brand/header-logo.png" Link="brand/header-logo.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../assets/brand/header-logo-dark.png" Link="brand/header-logo-dark.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../Licenses/*" Link="Licenses/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../assets/brand/partners/github/LICENSE.txt" Link="Licenses/Tabler.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../assets/brand/partners/github/OCTICONS-LICENSE.txt" Link="Licenses/Octicons.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../fc/models-dev-license.txt" Link="Licenses/models.dev-MIT.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../../LICENSE" Link="Licenses/AI-BenchGauge.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="PruneRemovedSupplierLogos" BeforeTargets="CopyFilesToOutputDirectory;ComputeFilesToPublish">
    <ItemGroup>
      <_RemovedSupplierLogo Include="$(OutDir)logos/*.png" Exclude="$(OutDir)logos/github.png" Condition="'$(OutDir)' != ''" />
      <_RemovedSupplierLogo Include="$(PublishDir)logos/*.png" Exclude="$(PublishDir)logos/github.png" Condition="'$(PublishDir)' != ''" />
    </ItemGroup>
    <Delete Files="@(_RemovedSupplierLogo)" />
  </Target>
</Project>
